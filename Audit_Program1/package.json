{
  "name": "audit-plus",
  "version": "4.3.7",
  "private": true,
  "description": "Audit-Plus \u2014 external audit master program (Arabic/English), runs fully in the browser",
  "scripts": {
    "dev": "node tools/dev.js",
    "build": "node tools/build.js",
    "build:dev": "node tools/build.js --dev",
    "test": "python3 tests/smoke.py dist/index.html",
    "format": "prettier --write \"js/**/*.js\" \"tools/*.js\" \"css/*.css\" index.html",
    "format:check": "prettier --check \"js/**/*.js\" \"tools/*.js\" \"css/*.css\" index.html",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run build"
  },
  "devDependencies": {
    "acorn": "^8.12.1",
    "acorn-walk": "^8.3.3",
    "esbuild": "^0.23.1",
    "eslint": "^9.12.0",
    "eslint-scope": "^8.0.2",
    "globals": "^15.10.0",
    "magic-string": "^0.30.11",
    "prettier": "3.3.3"
  }
}
